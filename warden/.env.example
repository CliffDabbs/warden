# Copy to .env (auto-loaded). NEVER commit the real .env.

# ── AdGuard Home ("adaware") ────────────────────────────────────────────────
# The admin API. Creds are HTTP Basic. Leave ADGUARD_MODE=auto to use the live
# server when reachable, else fall back to the in-memory fake (so the app always
# runs, even with no AdGuard around — great for demos/dev).
ADGUARD_URL=http://10.7.11.29
ADGUARD_USER=cliff
ADGUARD_PASS=change-me
ADGUARD_MODE=auto            # auto | live | fake

# ── Rule compiler LLM backend ───────────────────────────────────────────────
# How plain-English rules become typed rules. All optional — with none of this set,
# the built-in deterministic parser handles the common phrasings offline.
#   WARDEN_LLM=auto : use ANTHROPIC_API_KEY if set, else the Claude Code CLI if
#                     installed, else the parser.  (api | cli | off force a path)
WARDEN_LLM=auto
# Option 1 — an API key (billed to your Anthropic account):
ANTHROPIC_API_KEY=
# Option 2 — reuse your Claude Code login instead of a key (no extra billing):
#   set WARDEN_LLM=cli (or leave auto with no key). Needs the `claude` CLI on PATH.
WARDEN_CLAUDE_CLI=claude
WARDEN_LLM_MODEL=claude-haiku-4-5-20251001   # cheap+fast; maps to the CLI's haiku alias
# Model for the DYNAMIC RULE EVALUATOR only (blank = use WARDEN_LLM_MODEL). It both
# judges the rule and computes its next wake-up from clock/term/window arithmetic —
# measurably harder than compiling, and worth a stronger model.
WARDEN_EVAL_MODEL=claude-sonnet-5

# ── Login gate (basic auth) ─────────────────────────────────────────────────
# Set WARDEN_PASSWORD to require sign-in. Empty = open access (no login).
# The session cookie is signed and lasts ~10 years, so you log in once per device.
WARDEN_USERNAME=admin
WARDEN_PASSWORD=
# Optional explicit cookie-signing key; if unset it's derived from the credentials
# (so changing the password logs everyone out). Set a random string to pin it.
WARDEN_SECRET=

# ── Source secrets (one pair per pluggable source; see config/warden.yaml) ──
# Atom Learning uses Google sign-in, so there's no username/password here — instead
# capture the session once (opens a browser, you sign in with Google):
#     cd warden && .venv/Scripts/python.exe -m warden.adapters.atom.login
# That writes data/atom_state.json, which the adapter reuses headlessly. Re-run it
# when the session expires. (In a container, copy that file into the /app/data volume.)
WEDUC_USERNAME=
WEDUC_PASSWORD=

# ── NAS / host control (see hosts: in config/warden.yaml) ───────────────────
# SSH login Warden uses to start and stop services it cannot reach by DNS — a Plex
# server on your own LAN answers on its IP whatever the resolver says. Give it an
# account that can manage packages; it can run any command listed in managed_services.
QNAP_SSH_USER=
QNAP_SSH_PASS=

# ── Server ──────────────────────────────────────────────────────────────────
WARDEN_HOST=0.0.0.0
WARDEN_PORT=8080
WARDEN_DB=warden.db
WARDEN_TZ=Europe/London
# Safety-net tick for dynamic rules (they normally schedule their own next check).
WARDEN_EVAL_INTERVAL_MIN=60
# Rules decide on data that has already landed: an evaluation waits this long for a
# source collection that is running or overdue before going ahead without it.
WARDEN_COLLECT_WAIT_SEC=180
