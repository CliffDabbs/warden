# Copy to .env and fill in. .env is read automatically by deploy.py.
# NEVER commit the real .env.

# AdGuard (the tool calls its API directly)
ADGUARD_URL=http://10.7.11.29
ADGUARD_USER=cliff
ADGUARD_PASS=your-adguard-password

# Home Assistant config dir — the Samba share. On Windows a UNC path works:
HA_CONFIG_DIR=\\homeassistant\config
# ...or map it to a drive and use e.g.  Z:\

# Optional: auto-reload HA after writing (Long-Lived Access Token from your HA profile)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=paste-long-lived-token-here
